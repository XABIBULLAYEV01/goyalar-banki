datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  icon        String
  description String
  color       String
  ideas       Idea[]
  admins      Admin[]

  @@map("categories")
}

model Student {
  id         Int      @id @default(autoincrement())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  school     String
  className  String   @map("class_name")
  createdAt  DateTime @default(now()) @map("created_at")
  ideas      Idea[]

  @@map("students")
}

model Admin {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  passwordHash String        @map("password_hash")
  salt         String
  fullName     String        @map("full_name")
  role         String        // 'super_admin' or 'coordinator'
  categoryId   Int?          @map("category_id")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  lastLogin    DateTime?     @map("last_login")
  category     Category?     @relation(fields: [categoryId], references: [id])
  comments     IdeaComment[]
  logs         ActivityLog[]

  @@map("admins")
}

model Idea {
  id             Int           @id @default(autoincrement())
  trackingCode   String        @unique @map("tracking_code")
  studentId      Int           @map("student_id")
  categoryId     Int           @map("category_id")
  title          String
  problem        String
  description    String
  expectedResult String        @map("expected_result")
  attachmentUrl  String?       @map("attachment_url")
  attachmentName String?       @map("attachment_name")
  status         String        @default("Ko‘rib chiqilmoqda")
  likesCount     Int           @default(0) @map("likes_count")
  isFeatured     Boolean       @default(false) @map("is_featured")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category       Category      @relation(fields: [categoryId], references: [id])
  comments       IdeaComment[]

  @@map("ideas")
}

model IdeaComment {
  id        Int      @id @default(autoincrement())
  ideaId    Int      @map("idea_id")
  adminId   Int      @map("admin_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  admin     Admin    @relation(fields: [adminId], references: [id])

  @@map("idea_comments")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?     @map("admin_id")
  action    String
  details   String
  ipAddress String?  @default("127.0.0.1") @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin?   @relation(fields: [adminId], references: [id])

  @@map("activity_logs")
}
